#!/bin/bash
# OFTerm lifecycle entry point: start | stop | restart | status

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=common
source "${SCRIPT_DIR}/common"

case "$1" in
    start)
        start_app
        ;;
    stop)
        stop_app
        ;;
    restart)
        stop_app
        sleep 1
        start_app
        ;;
    status)
        if is_running && [ -S "${SOCKET_PATH}" ]; then
            exit 0
        fi
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 1
        ;;
esac
