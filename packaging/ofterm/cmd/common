#!/bin/bash
# OFTerm shared lifecycle helpers.

APP_NAME="ofterm"
LOG_FILE="${TRIM_PKGVAR}/${APP_NAME}.log"
PID_FILE="${TRIM_PKGVAR}/${APP_NAME}.pid"
SOCKET_PATH="${TRIM_APPDEST}/${APP_NAME}.sock"
BIN="${TRIM_APPDEST}/${APP_NAME}"

log_msg() {
    mkdir -p "$(dirname "${LOG_FILE}")" 2>/dev/null || true
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" | tee -a "${LOG_FILE}" >&2
}

check_process() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

read_pid() {
    [ -f "${PID_FILE}" ] && cat "${PID_FILE}" 2>/dev/null
}

is_running() {
    local pid
    pid="$(read_pid)"
    check_process "${pid}"
}

wait_for_socket() {
    local i=0
    while [ "$i" -lt 100 ]; do
        [ -S "${SOCKET_PATH}" ] && return 0
        is_running || return 1
        sleep 0.1
        i=$((i + 1))
    done
    return 1
}

stop_app() {
    local pid
    pid="$(read_pid)"
    if check_process "${pid}"; then
        log_msg "Stopping ${APP_NAME} (PID ${pid})"
        kill -TERM "${pid}" 2>/dev/null || true
        local i=0
        while check_process "${pid}" && [ "$i" -lt 100 ]; do
            sleep 0.1
            i=$((i + 1))
        done
        if check_process "${pid}"; then
            log_msg "Process did not exit, sending SIGKILL"
            kill -KILL "${pid}" 2>/dev/null || true
        fi
    fi
    rm -f "${PID_FILE}" "${SOCKET_PATH}"
    log_msg "Stopped"
}

start_app() {
    if is_running; then
        log_msg "Already running"
        return 0
    fi
    [ -x "${BIN}" ] || { log_msg "Missing binary: ${BIN}"; return 1; }

    mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
    rm -f "${SOCKET_PATH}"

    cd "${TRIM_APPDEST}" || return 1
    OFTERM_MODE=gateway \
    OFTERM_SOCKET="${SOCKET_PATH}" \
    OFTERM_DATA_DIR="${TRIM_PKGVAR}" \
    nohup "${BIN}" serve >> "${LOG_FILE}" 2>&1 &
    echo $! > "${PID_FILE}"

    if wait_for_socket; then
        log_msg "Started (PID $(cat "${PID_FILE}"), socket ${SOCKET_PATH})"
        return 0
    fi
    log_msg "Failed to create socket ${SOCKET_PATH}"
    stop_app
    return 1
}
