version=@VERSION@
appname=ofterm
desc=面向飞牛 fnOS 的开源 iTerm2 风格终端：分屏、标签页、终端内图片（imgcat/imgls）、经典配色，支持 x86_64/arm64。
display_name=OFTerm 终端
source=thirdparty
platform=@PLATFORM@
maintainer=@MAINTAINER@
maintainer_url=@MAINTAINER_URL@
distributor=@DISTRIBUTOR@
distributor_url=@DISTRIBUTOR_URL@
helpurl=@HELP_URL@
os_min_version=@OS_MIN_VERSION@
desktop_uidir=ui
desktop_applaunchname=ofterm.Application
ctl_stop=true
checkport=false
service_socket=ofterm.sock
install_type=root
changelog=@CHANGELOG@
