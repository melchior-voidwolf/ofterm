version=@VERSION@
appname=ofterm
desc=面向飞牛 fnOS 的开源终端应用，iTerm2 风格界面与设置，提供本地 Shell。
display_name=OFTerm 终端
source=thirdparty
platform=@PLATFORM@
maintainer=@MAINTAINER@
maintainer_url=@MAINTAINER_URL@
distributor=@DISTRIBUTOR@
distributor_url=@DISTRIBUTOR_URL@
helpurl=@HELP_URL@
os_min_version=@OS_MIN_VERSION@
desktop_uidir=ui
desktop_applaunchname=ofterm.Application
ctl_stop=true
checkport=false
service_socket=ofterm.sock
install_type=root
changelog=@CHANGELOG@
