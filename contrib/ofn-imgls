#!/usr/bin/env bash
# Fast imgls-style listing: thumbnails are resized to fit the requested cell
# size before transfer, so large photos do not send megabytes of base64.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
width=20
height=10
preserve=1
args=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --width|-W) width="$2"; shift 2 ;;
    --height|-H) height="$2"; shift 2 ;;
    --preserve_ratio|--preserve-ratio) preserve=1; shift ;;
    --no-preserve_ratio|--no-preserve-ratio|--stretch) preserve=0; shift ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do args+=("$1"); shift; done
      ;;
    -*) shift ;;
    *) args+=("$1"); shift ;;
  esac
done

if [ "${#args[@]}" -eq 0 ]; then
  args=(.)
fi

max_px=$((width * 14))
if [ "$max_px" -lt 240 ]; then max_px=240; fi
if [ "$max_px" -gt 960 ]; then max_px=960; fi

emit_one() {
  local f="$1"
  [ -e "$f" ] || return 0
  printf '%s\n' "$f"
  [ -f "$f" ] || return 0
  case "${f##*.}" in
    png|PNG|jpg|JPG|jpeg|JPEG|tif|TIF|tiff|TIFF|bmp|BMP|gif|GIF|webp|WEBP)
      local opts=(-W "$width" -H "$height")
      [ "$preserve" = "1" ] && opts+=(-r)
      OFN_IMG_MAX_PX="$max_px" "${here}/ofn-imgcat" "${opts[@]}" "$f"
      ;;
  esac
}

for target in "${args[@]}"; do
  if [ -d "$target" ]; then
    for entry in "$target"/*; do
      [ -e "$entry" ] && emit_one "$entry"
    done
  else
    emit_one "$target"
  fi
done
