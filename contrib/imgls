#!/usr/bin/env bash
# imgls: adaptive grid of inline thumbnails with filenames underneath (OSC 1337).
#
# Command-line compatible with iTerm2's imgls, implemented independently for
# OFTerm (GPL-2.0). Thumbnails are arranged in as many columns as the terminal
# is wide (typically 3-5), each filename is printed below its image, and every
# thumbnail is downscaled to the cell size before transfer so large photos do
# not send megabytes of base64. --dimensions shows pixel sizes on a second
# label line using whatever tool is available (magick/convert, exiftool, sips
# or php).
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
width=20
height=10
columns=0
preserve=1
dimensions=1
args=()

show_help() {
  cat >&2 <<'EOF'
Usage: imgls [--width N|--height N] [--columns N] [--preserve_ratio|--stretch]
             [--dimensions|--no-dimensions] [file|dir ...]

List images as an adaptive grid of inline thumbnails, with each filename below
its image. The column count follows the terminal width (typically 3-5 columns);
--columns N limits it. Defaults: 20x10 cell thumbnails, aspect ratio preserved,
pixel dimensions shown below filenames. Thumbnails are downscaled before
transfer via imgcat.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help) show_help; exit 0 ;;
    --width | -W) width="$2"; shift 2 ;;
    --height | -H) height="$2"; shift 2 ;;
    --columns | -C) columns="$2"; shift 2 ;;
    --preserve_ratio | --preserve-ratio) preserve=1; shift ;;
    --no-preserve_ratio | --no-preserve-ratio | --stretch) preserve=0; shift ;;
    --dimensions | -d) dimensions=1; shift ;;
    --no-dimensions | --nodimensions) dimensions=0; shift ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do args+=("$1"); shift; done
      ;;
    -*) shift ;;
    *) args+=("$1"); shift ;;
  esac
done

if [ "${#args[@]}" -eq 0 ]; then
  args=(.)
fi

# Terminal geometry: cells for the column count, 10x20 px estimate for the
# row height of aspect-preserved thumbnails (same assumption as imgcat).
term_cols=80
size="$(stty size 2>/dev/null || echo '24 80')"
term_rows="${size%% *}"
term_cols="${size##* }"
case "$term_cols" in ''|*[!0-9]*) term_cols=80 ;; esac

[ "$width" -gt "$term_cols" ] && width=$((term_cols > 1 ? term_cols - 1 : 1))

gap=2
auto_columns=$(((term_cols + gap) / (width + gap)))
[ "$auto_columns" -lt 1 ] && auto_columns=1
if [ "$columns" -ge 1 ]; then
  [ "$columns" -gt "$auto_columns" ] && columns=$auto_columns
else
  columns=$auto_columns
fi

max_px=$((width * 14))
if [ "$max_px" -lt 240 ]; then max_px=240; fi
if [ "$max_px" -gt 960 ]; then max_px=960; fi

is_image() {
  case "${1##*.}" in
    png | PNG | jpg | JPG | jpeg | JPEG | tif | TIF | tiff | TIFF | bmp | BMP | gif | GIF | webp | WEBP) return 0 ;;
    *) return 1 ;;
  esac
}

# print "WxH" for an image file, or nothing if no tool can read it.
image_dims() {
  local f="$1" d
  if command -v magick >/dev/null 2>&1; then
    d="$(magick identify -format '%w %h' "$f" 2>/dev/null | head -1)" && [ -n "$d" ] && echo "${d%% *}x${d##* }" && return 0
  elif command -v identify >/dev/null 2>&1; then
    d="$(identify -format '%w %h' "$f" 2>/dev/null | head -1)" && [ -n "$d" ] && echo "${d%% *}x${d##* }" && return 0
  elif command -v exiftool >/dev/null 2>&1; then
    d="$(exiftool -s3 -ImageWidth -ImageHeight "$f" 2>/dev/null | tr '\n' ' ')" && [ -n "${d// /}" ] && echo "${d%% *}x${d##* }" && return 0
  elif command -v sips >/dev/null 2>&1; then
    d="$(sips -g pixelWidth -g pixelHeight "$f" 2>/dev/null | awk '/pixel/{printf "%s ", $2}')" && [ -n "${d// /}" ] && echo "${d%% *}x${d##* }" && return 0
  elif command -v php >/dev/null 2>&1; then
    d="$(php -r '$s=@getimagesize($argv[1]); if($s) echo $s[0]," ",$s[1];' "$f" 2>/dev/null)" && [ -n "$d" ] && echo "${d%% *}x${d##* }" && return 0
  fi
  return 1
}

# Approximate display width: ASCII counts 1, characters that take extra UTF-8
# bytes count wider (CJK is 3 bytes / 2 cells). Good enough for grid labels.
label_width() {
  local s="$1" chars bytes
  chars=$(printf '%s' "$s" | wc -m | tr -d ' ')
  bytes=$(printf '%s' "$s" | wc -c | tr -d ' ')
  echo $((chars + (bytes - chars) / 2))
}

# Echo the label padded to $2 display cells, truncating with an ellipsis.
fit_label() {
  local s="$1" want="$2" w cut
  w=$(label_width "$s")
  if [ "$w" -le "$want" ]; then
    printf '%s%*s' "$s" $((want - w)) ''
    return
  fi
  if [ "$want" -le 1 ]; then
    printf '…'
    return
  fi
  cut=$((want - 1))
  printf '%s…' "$(printf '%s' "$s" | cut -c1-"$cut")"
}

# Rows of [path|dims] pairs, buffered until the row is full.
row_paths=()
row_dims=()
row_height=1

# How many terminal rows a WxH image occupies at the given cell width.
thumb_rows() {
  local w="$1" h="$2"
  if [ "$preserve" = 0 ]; then
    echo "$height"
    return
  fi
  # cells = ceil(width * h / w / 2); 2 = assumed cell width/height ratio.
  echo $(( (width * h + 2 * w - 1) / (2 * w) ))
}

flush_row() {
  [ "${#row_paths[@]}" -gt 0 ] || return 0
  local i x needed label_lines
  [ "$dimensions" = 1 ] && label_lines=2 || label_lines=1
  needed=$((row_height + 1 + label_lines))

  # Reserve screen space first: real newlines scroll at the bottom margin,
  # moving back up leaves the cursor at the grid origin.
  for ((i = 0; i < needed; i++)); do printf '\n'; done
  printf '\033[%dA\r' "$needed"

  for ((i = 0; i < ${#row_paths[@]}; i++)); do
    x=$((i * (width + gap) + 1))
    printf '\033[%dG' "$x"
    printf '\0337'
    local opts=(-W "$width" -H "$height")
    [ "$preserve" = 1 ] && opts+=(-r)
    # The DECRC below also undoes imgcat's trailing newline.
    OFN_IMG_MAX_PX="$max_px" OFN_IMG_ANCHOR=1 "${here}/imgcat" "${opts[@]}" "${row_paths[$i]}" || true
    printf '\0338'
  done

  printf '\r\033[%dB' "$((row_height + 1))"
  for ((i = 0; i < ${#row_paths[@]}; i++)); do
    label="$(fit_label "$(basename "${row_paths[$i]}")" "$width")"
    if [ "$i" -lt $((${#row_paths[@]} - 1)) ]; then
      printf '%s%*s' "$label" "$gap" ''
    else
      printf '%s' "${label%% }"
    fi
  done
  printf '\n'
  if [ "$dimensions" = 1 ]; then
    for ((i = 0; i < ${#row_paths[@]}; i++)); do
      label="$(fit_label "[${row_dims[$i]}]" "$width")"
      if [ "$i" -lt $((${#row_paths[@]} - 1)) ]; then
        printf '%s%*s' "$label" "$gap" ''
      else
        printf '%s' "${label%% }"
      fi
    done
    printf '\n'
  fi
  row_paths=()
  row_dims=()
  row_height=1
}

queue_image() {
  local f="$1" d rows
  d="$(image_dims "$f" || true)"
  if [ -z "$d" ]; then
    flush_row
    printf '%s\n' "$f"
    return 0
  fi
  row_paths+=("$f")
  row_dims+=("$d")
  rows="$(thumb_rows "${d%%x*}" "${d##*x}")"
  if [ "$rows" -gt "$row_height" ]; then row_height=$rows; fi
  if [ "${#row_paths[@]}" -ge "$columns" ]; then flush_row; fi
  return 0
}

emit_one() {
  local f="$1"
  [ -e "$f" ] || return 0
  if [ -f "$f" ] && is_image "$f"; then
    queue_image "$f"
    return
  fi
  flush_row
  printf '%s\n' "$f"
}

for target in "${args[@]}"; do
  if [ -d "$target" ]; then
    [ "${#args[@]}" -gt 1 ] && printf '%s:\n' "$target"
    for entry in "$target"/*; do
      [ -e "$entry" ] && emit_one "$entry"
    done
  else
    emit_one "$target"
  fi
done
flush_row
